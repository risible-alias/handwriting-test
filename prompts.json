      "requires": "latex-v4"
    },
    {
      "id": "web-v1-long-3",
      "category": "long",
      "latex": "\\int_{1}^{e}\\frac{\\ln x}{x}dx=[\\frac{(\\ln x)^{2}}{2}]_{1}^{e}=\\frac{1}{2}",
      "instruction": "Keep it on one line. Write a bit smaller if you need to.",
      "requires": "latex-v4"
    },
    {
      "id": "web-v1-long-4",
      "category": "long",
      "latex": "\\lim_{x\\rightarrow0}\\frac{1-\\cos x}{x^{2}}=\\lim_{x\\rightarrow0}\\frac{\\sin x}{2x}=\\frac{1}{2}",
      "instruction": "Keep it on one line. Write a bit smaller if you need to.",
      "requires": "latex-v4"
    },
    {
      "id": "web-v1-words-1",
      "category": "words",
      "latex": "\\text{Let}\\ \\epsilon>0\\ \\text{be arbitrary.}",
      "instruction": "Write the words in your normal handwriting.",
      "requires": "latex-v4"
    },
    {
      "id": "web-v1-words-2",
      "category": "words",
      "latex": "\\text{for all}\\ x\\in\\mathbb{R},\\ f(x)\\geq0",
      "instruction": "Write the words in your normal handwriting.",
      "requires": "latex-v4"
    },
    {
      "id": "web-v1-words-3",
      "category": "words",
      "latex": "\\text{so the area is}\\ 12\\ \\text{square units}",
      "instruction": "Write the words in your normal handwriting.",
      "requires": "latex-v4"
    },
    {
      "id": "web-v1-words-4",
      "category": "words",
      "latex": "\\text{hence}\\ a_{n}\\rightarrow L\\ \\text{as}\\ n\\rightarrow\\infty",
      "instruction": "Write the words in your normal handwriting.",
      "requires": "latex-v4"
    },
    {
      "id": "web-v1-notation-1",
      "category": "notation",
      "latex": "\\sup_{x\\in[0,1]}|f(x)|\\leq M",
      "instruction": null,
      "requires": "latex-v5 (pending vocabulary expansion)"
    },
    {
